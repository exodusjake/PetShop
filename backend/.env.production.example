# Production settings. On the API server copy this to  backend/.env  and fill it in.  (chmod 600 .env)
NODE_ENV=production
PORT=4000

# Your public website address. Used for the CORS/CSRF allow-list and password-reset links.
CORS_ORIGIN=https://shop.example.com
PUBLIC_URL=https://shop.example.com

# RDS SQL Server. Put the password in {braces} so ; or # inside it are safe.
DATABASE_URL="sqlserver://YOUR-RDS-ENDPOINT.rds.amazonaws.com:1433;database=pawzora_store;user=YOUR_MASTER_USER;password={YOUR_PASSWORD};trustServerCertificate=true;encrypt=true"

# Email for password resets and order confirmations (any SMTP server). Amazon SES example: create SMTP credentials in the SES console
# and verify your sending domain or address first. Without these, customers who forget their password cannot recover their account.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
MAIL_FROM="Pawzora <no-reply@shop.example.com>"

# Cash on Delivery is the only live payment method until a payment provider is integrated.
# (The server refuses to start if online methods are listed without a provider.)
PAYMENT_METHODS_ENABLED=COD

# Login cookies are marked Secure (HTTPS only) in production. Only for testing over plain http://, uncomment:
# COOKIE_SECURE=false

# Do NOT set SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD here. Create the first admin with:  npm run admin:create
