PORT=4000
# Frontend origin(s) allowed to call the API (comma-separated). Not needed when nginx proxies /api.
CORS_ORIGIN=http://localhost:5173

# SQL Server connection. Wrap the password in {braces} if it contains ; or # characters.
# Local:  sqlserver://localhost:1433;database=pawzora_store;user=sa;password={YourPassword};trustServerCertificate=true;encrypt=false
# AWS RDS: sqlserver://<rds-endpoint>:1433;database=pawzora_store;user=admin;password={...};trustServerCertificate=true;encrypt=true
DATABASE_URL="sqlserver://localhost:1433;database=pawzora_store;user=sa;password={YourPassword};trustServerCertificate=true;encrypt=false"

# Dev-only seed accounts. The admin is created ONLY if both are set (never in production).
SEED_ADMIN_EMAIL=admin@pawzora.local
SEED_ADMIN_PASSWORD="ChangeMe#Admin1"
# Password for the demo customer customer@pawzora.demo (default Customer#12345)
# SEED_DEMO_PASSWORD=

# Shipping fees and the free-shipping threshold are Store Settings in the database (shipping_standard_fee, shipping_express_fee, free_shipping_over).
# Payment methods offered at checkout. Only COD is real today; add GCASH,MAYA,CARD only after a payment provider
# with signature-verified webhooks is integrated (payment success must never be confirmed by the browser).
PAYMENT_METHODS_ENABLED=COD

# Optional in development: send real emails (password reset, order confirmation) through an SMTP server.
# Without it, the reset link is printed in the API console and shown on the page instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Pawzora <no-reply@example.com>"
